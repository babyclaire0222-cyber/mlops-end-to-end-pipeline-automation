# Copy this file to `.env` and populate with real values.
# Never commit the actual `.env` file to version control.

# --- AWS credentials (used by boto3 via the default credential chain) ---
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_DEFAULT_REGION=us-east-1

# --- MLflow tracking server (optional override of config.yaml) ---
MLFLOW_TRACKING_URI=mlruns

# --- Path to config file (optional override) ---
CONFIG_PATH=config/config.yaml
